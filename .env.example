GITHUB_CLIENT_ID=your-github-oauth-client-id
# Development may use the value variables below. Public mode rejects secret
# values from the environment and requires the matching owner-only *_FILE path.
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_CLIENT_SECRET_FILE=
JWT_SECRET=change-this-to-random-string
JWT_SECRET_FILE=
# Deprecated since pass 2: refresh tokens are opaque + hashed in DB, so this
# secret is no longer used for token operations. Kept (and boot-validated)
# for deploy compatibility.
JWT_REFRESH_SECRET=change-this-to-another-random-string
JWT_REFRESH_SECRET_FILE=
DATABASE_URL=postgres://k8squiz:k8squiz@localhost:5432/k8squiz?sslmode=disable
DATABASE_URL_FILE=
# Development may use automatic migrations. Public mode must use external and
# run the separate control-plane-db migrator before starting the server.
DATABASE_MIGRATION_MODE=auto
# Public mode additionally requires all five non-secret role names and an
# operator confirmation that the whole PostgreSQL cluster is dedicated to this
# Control Plane. The server receives only the runtime URL; never mount the
# migrator, provisioner, or proof-validator URL into the backend container.
DATABASE_CATALOG_OWNER_ROLE=
DATABASE_OWNER_ROLE=
DATABASE_MIGRATOR_ROLE=
DATABASE_RUNTIME_ROLE=
DATABASE_VALIDATOR_ROLE=
DATABASE_DEDICATED_CLUSTER=false
PROBLEMS_REPO_PATH=./problems
# Durable content-addressed runtime artifacts. Keep this outside and disjoint
# from the mutable problems checkout; do not use a temporary directory.
PROBLEM_ARTIFACT_STORE_PATH=./data/problem-artifacts
FRONTEND_URL=http://localhost:5173
# Local Docker is accepted only in explicit development mode and on a safe
# bind host. Public mode remains unavailable until a KVM Runner is implemented.
DEPLOYMENT_MODE=development
SERVER_BIND_MODE=loopback
SERVER_HOST=127.0.0.1
# Slice 1 implements local-docker for trusted local development only.
# Public/non-local startup rejects it; home-proxmox and cloud do not silently
# fall back until their providers are implemented and pass isolation gates.
RUNNER_PROVIDER=local-docker
# Stable controller ownership scope. Use a distinct value for every checkout
# or Compose project sharing the same Docker daemon.
RUNNER_SCOPE=replace-with-a-unique-project-scope
DOCKER_HOST=unix:///var/run/docker.sock
SERVER_PORT=8080
# Global cap on active problem sessions. Public mode requires an explicit
# positive integer; 0 is accepted only for local development. Above the cap,
# POST /api/problems/:id/start returns 429.
MAX_CONCURRENT_SESSIONS=0
LLM_API_KEY=
# Required instead of LLM_API_KEY when public mode enables LLM grading.
LLM_API_KEY_FILE=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# Legacy container pre-warm pool. Non-zero values are rejected because the
# pool cannot preserve generation-bound allocation identity.
POOL_SIZE=0
POOL_IMAGE=k3s-base:latest
